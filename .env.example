# FRED_API_KEY is NOT required for Phase 1/2 — DGS10 is fetched via the free
# fredgraph.csv endpoint. Uncomment/set only if switching to FRED's official API.
# FRED_API_KEY=

# Primary Layer 2 fundamentals source (EODHD Fundamentals Data Feed plan) --
# used by agents/fundamental.py and agents/orchestrator.py by default.
# data/eodhd.py fetch_and_store_historical_fundamentals() also uses this to
# backfill point-in-time historical fundamentals for backtesting.
EODHD_API_KEY=

# Kept as an alternate/fallback fundamentals source (data/fundamentals.py) --
# current/TTM data only, no point-in-time history. Not used by default.
FMP_API_KEY=
